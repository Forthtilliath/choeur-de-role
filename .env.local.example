# =============================================================================
#  Chœur de Rôle — variables d'environnement
# =============================================================================
#  Copier ce fichier vers .env.local puis renseigner les valeurs.
#
#    cp .env.local.example .env.local
#
#  Deux modes possibles :
#    • MODE LOCAL   → Supabase tourne dans Docker (npm run dev:e2e / dev:local).
#                     Les valeurs par défaut ci-dessous suffisent, SKIP_ENV_VALIDATION=1
#                     désactive la validation des services externes non configurés.
#    • MODE CLOUD   → l'app pointe vers un vrai projet Supabase + services tiers
#                     (npm run dev). Retirer SKIP_ENV_VALIDATION et tout renseigner.
#
#  Voir SETUP.md pour la marche à suivre complète.
# =============================================================================

# -- Mode local : ne PAS valider les variables des services externes absents ---
#    À COMMENTER en mode cloud pour que la validation Zod (src/env.ts) s'applique.
SKIP_ENV_VALIDATION=1

# -----------------------------------------------------------------------------
#  Authentification / URL du site
# -----------------------------------------------------------------------------
# Secret de session — générer avec :  openssl rand -hex 32
AUTH_SECRET=change-me-openssl-rand-hex-32
# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
#  Supabase
# -----------------------------------------------------------------------------
# MODE LOCAL (valeurs standard générées par `supabase start`, identiques partout)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
#
# MODE CLOUD (récupérer dans le dashboard Supabase → Project Settings → API)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...   (secret — jamais exposé côté client)

# -----------------------------------------------------------------------------
#  Email transactionnel — Resend  (https://resend.com)
# -----------------------------------------------------------------------------
# Laisser vide en mode local (formulaire de contact inactif).
RESEND_API_KEY=
# Adresse destinataire du formulaire de contact.
NEXT_MAIL_CONTACT=contact@example.com

# -----------------------------------------------------------------------------
#  YouTube Data API v3 — galerie vidéos
#  Google Cloud Console → API & Services → Credentials → API key
# -----------------------------------------------------------------------------
# Laisser vide en mode local (playlist vidéo non synchronisée).
YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
#  Stockage fichiers — Cloudflare R2  (répertoire, images)
#  Cloudflare dashboard → R2 → créer 2 buckets + un token API S3.
#  Sans R2 valide, le build passe mais l'upload/lecture de fichiers échoue au runtime.
#  Alternative : Supabase Storage (fallback géré par l'app).
# -----------------------------------------------------------------------------
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=cdr-repertoire
CLOUDFLARE_R2_IMAGES_BUCKET_NAME=cdr-images
# URL publique du bucket images (R2 → Settings → Public access → r2.dev)
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# -----------------------------------------------------------------------------
#  Monitoring — Sentry  (optionnel)
# -----------------------------------------------------------------------------
# DSN client (public). Laisser vide pour désactiver le reporting d'erreurs.
NEXT_PUBLIC_SENTRY_DSN=
# Upload des source maps au build uniquement (optionnel).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
#  Analytics — Umami  (optionnel)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
